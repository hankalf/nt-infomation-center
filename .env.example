# Copy these into Railway → your service → Variables (see README)

# REQUIRED on first start: password for the built-in "admin" login
ADMIN_PASSWORD=change-me-to-something-long

# Emergency only: set to true and redeploy to reset the "admin" password to ADMIN_PASSWORD.
# Remove it again afterwards.
RESET_ADMIN_PASSWORD=

# Optional: random string used to sign login cookies (auto-generated and kept on the Volume if empty)
SESSION_SECRET=

# Optional: where data is stored. On Railway this defaults to the attached Volume automatically.
DATA_DIR=

# Optional: max upload size per document in MB (default 50)
MAX_UPLOAD_MB=50

# Optional: max backup zip size you can restore, in MB (default 2048)
MAX_RESTORE_MB=2048
