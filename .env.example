# Copy to Railway → your service → Variables (or a local .env for reference)

# REQUIRED: password for the /admin page
ADMIN_PASSWORD=change-me-to-something-long

# Optional: extra secret mixed into the login cookie signature
SESSION_SECRET=

# Optional: where content.json and uploads are stored.
# On Railway this defaults to the attached Volume's mount path automatically.
DATA_DIR=

# Optional: maximum upload size in MB (default 50)
MAX_UPLOAD_MB=50
