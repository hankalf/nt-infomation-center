# Copy these into Railway → your Employee Hub service → Variables (see README)

# REQUIRED: password for the admin area at /admin
ADMIN_PASSWORD=change-me-to-something-long

# REQUIRED for board panels: a monday.com personal API token
# (monday.com → your avatar → Developers → My access tokens). Form tiles and quick links work without it.
MONDAY_API_TOKEN=

# Optional: random string used to sign the admin login cookie (auto-generated and kept on the Volume if empty)
SESSION_SECRET=

# Optional: where settings are stored. On Railway this defaults to the attached Volume automatically.
DATA_DIR=

# Optional: the public web address of the hub, used for the QR code (defaults to the address the page is opened on)
PUBLIC_URL=

# Optional: how long board data is cached before asking monday.com again, in seconds (default 45)
MONDAY_CACHE_SECONDS=45
